 "passages": [
  {
   "id": "P-N04",
   "title": "The Rise of Repair Cafes",
   "genre": "society",
   "source": "original",
   "license": "project-original",
   "paragraphs": [
    {
     "id": "P-N04-p1",
     "label": "A",
     "sentences": [
      {
       "index": 1,
       "text": "Repair cafes first appeared in the Netherlands in 2009 and have since spread to many countries."
      },
      {
       "index": 2,
       "text": "At a repair cafe, visitors bring broken household items, such as lamps, bicycles and clothing, and repair them with the help of volunteers."
      },
      {
       "index": 3,
       "text": "The cafes are free to enter, although visitors usually buy a drink and are expected to attempt the repair themselves rather than simply hand the item over."
      },
      {
       "index": 4,
       "text": "Supporters say the movement reduces waste, because fewer products are thrown away, and teaches practical skills that many people have lost."
      },
      {
       "index": 5,
       "text": "Critics point out that some modern products are designed so that they cannot be opened, which makes repairing them almost impossible."
      },
      {
       "index": 6,
       "text": "Even so, a single cafe can hold only a limited number of visitors each month, so the direct effect on total waste remains small."
      }
     ]
    }
   ]
  }
 ],
 "clips": [
  {
   "id": "A-N02",
   "title": "Booking a train ticket",
   "lines": [
    {
     "speaker": "Clerk",
     "text": "Good afternoon. How can I help you?"
    },
    {
     "speaker": "Man",
     "text": "I would like a ticket to Bristol on Friday morning, please."
    },
    {
     "speaker": "Clerk",
     "text": "The eight fifteen train arrives at ten forty. A return ticket costs forty-six pounds."
    },
    {
     "speaker": "Man",
     "text": "Is there a cheaper train?"
    },
    {
     "speaker": "Clerk",
     "text": "The nine fifty is thirty-nine pounds return, but it stops at more stations, so it takes longer."
    }
   ]
  }
 ],
