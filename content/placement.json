 "passages": [
  {
   "id": "PL-PA",
   "title": "The Night Train Returns",
   "sentences": [
    "After decades of decline, night trains are returning to European railways.",
    "In the 1980s and 1990s, cheap flights and faster daytime trains led many companies to cancel overnight services.",
    "Now, concern about the climate is changing travellers' habits.",
    "A sleeper train produces far less carbon dioxide per passenger than a short flight, and passengers can sleep while they travel, arriving in a city centre rather than at a distant airport.",
    "Tickets, however, are not always cheap: a private cabin on a popular route can cost more than a hotel room.",
    "Operators say demand is strongest among younger travellers, who book early to find lower prices."
   ]
  },
  {
   "id": "PL-PB",
   "title": "Salt: A Short History",
   "sentences": [
    "For most of human history, salt was far more than a seasoning.",
    "Because it could preserve food, it was essential for survival, and in some regions it was used as money.",
    "Roman soldiers are sometimes said to have been paid in salt, which is where the English word 'salary' comes from.",
    "Salt was so valuable that governments taxed it heavily, and in several countries these taxes caused public anger.",
    "The invention of refrigeration in the nineteenth century reduced salt's importance for preserving food.",
    "Today salt is cheap and plentiful, and doctors instead warn that eating too much of it can raise blood pressure."
   ]
  }
 ],
 "clips": [
  {
   "id": "PL-LA",
   "title": "Joining the library",
   "lines": [
    {
     "speaker": "Librarian",
     "text": "Good morning. Would you like to join the library?"
    },
    {
     "speaker": "Woman",
     "text": "Yes, please. My name is Marta Kovac. That is K-O-V-A-C."
    },
    {
     "speaker": "Librarian",
     "text": "And a contact number, please?"
    },
    {
     "speaker": "Woman",
     "text": "My mobile is 07742 815309."
    },
    {
     "speaker": "Librarian",
     "text": "Thank you. Your card will be ready on Thursday. Please note that the library closes early, at five o'clock, on Wednesdays."
    }
   ]
  },
  {
   "id": "PL-LB",
   "title": "Museum exhibition",
   "lines": [
    {
     "speaker": "Guide",
     "text": "Welcome to the City Museum. Our new exhibition, Oceans of Plastic, opens this Friday and runs until the end of March."
    },
    {
     "speaker": "Guide",
     "text": "The exhibition includes photographs from thirty countries and a full-size boat built entirely from plastic bottles collected on local beaches."
    },
    {
     "speaker": "Guide",
     "text": "On Saturday afternoons, visitors can join a free workshop where artists show how waste materials can be turned into useful objects."
    },
    {
     "speaker": "Guide",
     "text": "Please note that the museum cafe will be closed during February for repairs, although the shop will remain open."
    }
   ]
  },
  {
   "id": "PL-LC",
   "title": "Photography course",
   "lines": [
    {
     "speaker": "Man",
     "text": "Hello, I would like to ask about the photography course."
    },
    {
     "speaker": "Woman",
     "text": "Of course. The course begins on Tuesday the twelfth. No, sorry, it begins on Wednesday the thirteenth, because the studio is being painted."
    },
    {
     "speaker": "Man",
     "text": "And how much does it cost?"
    },
    {
     "speaker": "Woman",
     "text": "It is one hundred and eighty pounds for eight weeks. Students need to bring their own camera, but all other materials are included."
    }
   ]
  }
 ],
